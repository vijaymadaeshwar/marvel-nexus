{
  "name": "marvel-nexus",
  "version": "2.0.0",
  "description": "The whole Marvel timeline, charted as one atlas — every movie, television series and Disney+ show from Iron Man to Secret Wars.",
  "author": "Marvel Nexus",
  "license": "MIT",
  "private": true,
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap sync android",
    "cap:ios": "npx cap sync ios",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "desktop:build": "npm run build && node scripts/build-desktop.cjs",
    "desktop:run": "npx electron .",
    "icons": "node scripts/generate-icons.cjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@playwright/test": "^1.45.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "idb": "^8.0.0"
  }
}
